# Copie ce fichier en .env pour travailler en local contre la base de production.
# Sur Vercel, renseigne ces mêmes variables dans Settings > Environment Variables.

DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=0
# Domaines autorisés (séparés par des virgules). Ajoute ton domaine perso si tu en as un.
DJANGO_ALLOWED_HOSTS=.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Base Postgres (Neon, Supabase…)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/postgres?sslmode=require

# Stockage des images et du CV (exemple Supabase Storage)
AWS_STORAGE_BUCKET_NAME=media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://<projet>.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_CUSTOM_DOMAIN=<projet>.supabase.co/storage/v1/object/public/media
